{
  "name": "omen-models",
  "displayName": "Omen AI Models & Downloader",
  "description": "Universal Language Model Provider (Local Ollama, LAN Cluster, DeepSeek, OpenAI, Anthropic, Gemini, Meta, OpenRouter) and Default Chat Participant for Omen",
  "version": "0.1.0",
  "publisher": "omen",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [
    "*"
  ],
  "enabledApiProposals": [
    "chatProvider",
    "defaultChatParticipant",
    "chatParticipantAdditions",
    "chatParticipantPrivate"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "omen",
        "displayName": "Omen AI Models"
      }
    ],
    "chatParticipants": [
      {
        "id": "omen.agent",
        "name": "omen",
        "fullName": "Omen Agent",
        "description": "Build, edit, and ask with Local Ollama, LAN GPU Cluster, or Third-Party Cloud LLMs",
        "isDefault": true,
        "isSticky": true,
        "modes": [
          "agent",
          "ask",
          "edit"
        ],
        "locations": [
          "panel",
          "editor",
          "terminal",
          "notebook"
        ],
        "commands": [
          {
            "name": "edit",
            "description": "Edit the active workspace file and stage a side-by-side diff"
          },
          {
            "name": "cluster",
            "description": "Show LAN GPU Cluster status and paired workers"
          },
          {
            "name": "keys",
            "description": "Configure Third-Party LLM API Keys"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omen-conversations",
          "title": "Chat",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "omen-tools",
          "title": "Omen Cluster & Docs",
          "icon": "$(server-process)"
        }
      ]
    },
    "views": {
      "omen-conversations": [
        {
          "type": "webview",
          "id": "omen.conversationsView",
          "name": "Chat",
          "icon": "$(comment-discussion)"
        }
      ],
      "omen-tools": [
        {
          "type": "webview",
          "id": "omen.clusterView",
          "name": "Compute Cluster",
          "icon": "$(server-process)"
        },
        {
          "type": "webview",
          "id": "omen.docsView",
          "name": "Docs & RAG",
          "icon": "$(book)"
        }
      ]
    },
    "commands": [
      {
        "command": "omen.openAgentHub",
        "title": "Open Built-in AI Chat in Center Editor",
        "shortTitle": "Open Chat",
        "category": "Omen",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "omen.cluster.refresh",
        "title": "Refresh Hardware",
        "category": "Omen",
        "icon": "$(refresh)"
      },
      {
        "command": "omen.cluster.pairWorker",
        "title": "Pair LAN Worker",
        "category": "Omen",
        "icon": "$(add)"
      },
      {
        "command": "omen.llamacpp.start",
        "title": "Start llama-server",
        "category": "Omen",
        "icon": "$(play)"
      },
      {
        "command": "omen.llamacpp.stop",
        "title": "Stop llama-server",
        "category": "Omen",
        "icon": "$(stop)"
      },
      {
        "command": "omen.llamacpp.setModel",
        "title": "Set llama.cpp Model File",
        "category": "Omen"
      },
      {
        "command": "omen.llamacpp.setWorker",
        "title": "Set llama.cpp RPC Worker",
        "category": "Omen"
      },
      {
        "command": "omen.docs.syncActiveFile",
        "title": "Sync Active File",
        "category": "Omen",
        "icon": "$(sync)"
      },
      {
        "command": "omen.docs.addCollection",
        "title": "New Vector Collection",
        "category": "Omen",
        "icon": "$(database)"
      },
      {
        "command": "omen.manageModels",
        "title": "Manage & Download Local Models (Ollama)",
        "category": "Omen"
      },
      {
        "command": "omen.setApiKey",
        "title": "Set API Key (DeepSeek / OpenAI / Anthropic / Gemini / Meta / OpenRouter)",
        "category": "Omen"
      },
      {
        "command": "omen.openSettingsHub",
        "title": "Open Settings & External API Keys Page",
        "category": "Omen"
      },
      {
        "command": "omen.refreshModels",
        "title": "Refresh AI Models",
        "category": "Omen"
      },
      {
        "command": "omen.openDocsHub",
        "title": "Open Docs & RAG Hub",
        "category": "Omen"
      },
      {
        "command": "omen.openClusterHub",
        "title": "Open Compute Cluster & Pairing Portal",
        "category": "Omen"
      },
      {
        "command": "omen.openAgentsView",
        "title": "Focus Conversations Sidebar",
        "category": "Omen"
      },
      {
        "command": "omen.newAgent",
        "title": "Start New Chat in Center Editor",
        "category": "Omen"
      },
      {
        "command": "omen.reviewSessionDiff",
        "title": "Review Staged Agent Diff",
        "category": "Omen"
      },
      {
        "command": "omen.acceptSessionDiff",
        "title": "Accept Staged Agent Diff",
        "category": "Omen"
      },
      {
        "command": "omen.rejectSessionDiff",
        "title": "Reject Staged Agent Diff",
        "category": "Omen"
      }
    ],
    "keybindings": [
      {
        "command": "omen.conversationsView.focus",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "omen.conversationsView.focus",
        "key": "ctrl+l",
        "mac": "cmd+l"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "omen.cluster.pairWorker",
          "when": "view == omen.clusterView",
          "group": "navigation@1"
        },
        {
          "command": "omen.cluster.refresh",
          "when": "view == omen.clusterView",
          "group": "navigation@2"
        },
        {
          "command": "omen.openAgentHub",
          "when": "view == omen.clusterView",
          "group": "navigation@3"
        },
        {
          "command": "omen.docs.addCollection",
          "when": "view == omen.docsView",
          "group": "navigation@1"
        },
        {
          "command": "omen.docs.syncActiveFile",
          "when": "view == omen.docsView",
          "group": "navigation@2"
        },
        {
          "command": "omen.openAgentHub",
          "when": "view == omen.docsView",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "omen.openAgentHub"
        },
        {
          "command": "omen.openAgentsView"
        },
        {
          "command": "omen.newAgent"
        },
        {
          "command": "omen.manageModels"
        },
        {
          "command": "omen.setApiKey"
        },
        {
          "command": "omen.openSettingsHub"
        },
        {
          "command": "omen.refreshModels"
        },
        {
          "command": "omen.openDocsHub"
        },
        {
          "command": "omen.openClusterHub"
        }
      ]
    },
    "configuration": {
      "title": "Omen AI Models",
      "properties": {
        "omen.providers.deepseek.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DeepSeek models (deepseek-chat, deepseek-reasoner)"
        },
        "omen.providers.deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "Custom DeepSeek API endpoint"
        },
        "omen.providers.openai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable OpenAI models (gpt-4o, gpt-4o-mini, o3-mini)"
        },
        "omen.providers.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Custom OpenAI API endpoint"
        },
        "omen.providers.anthropic.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Anthropic Claude models (claude-3-7-sonnet-latest, claude-3-5-haiku-latest)"
        },
        "omen.providers.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com/v1",
          "description": "Anthropic API endpoint"
        },
        "omen.providers.gemini.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Google Gemini models (gemini-2.5-pro, gemini-2.5-flash)"
        },
        "omen.providers.gemini.baseUrl": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta/openai",
          "description": "Google Gemini OpenAI-compatible API endpoint"
        },
        "omen.providers.meta.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Meta models (Muse Spark, Muse Wonder, Llama 3.3)"
        },
        "omen.providers.meta.baseUrl": {
          "type": "string",
          "default": "https://api.meta.ai/v1",
          "description": "Meta Model API endpoint URL (https://api.meta.ai/v1)"
        },
        "omen.providers.openrouter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable OpenRouter unified third-party models"
        },
        "omen.providers.openrouter.baseUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "OpenRouter API endpoint URL"
        },
        "omen.providers.ollama.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local Ollama model auto-discovery"
        },
        "omen.providers.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local or LAN Ollama endpoint URL"
        },
        "omen.providers.llamacpp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local llama-server model"
        },
        "omen.providers.llamacpp.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Local llama-server frontend URL"
        },
        "omen.providers.llamacpp.port": {
          "type": "number",
          "default": 8080,
          "description": "Local llama-server port"
        },
        "omen.providers.llamacpp.binaryPath": {
          "type": "string",
          "default": "llama-server",
          "description": "llama-server binary path"
        },
        "omen.providers.llamacpp.modelPath": {
          "type": "string",
          "default": "",
          "description": "Full path to local .gguf model file"
        },
        "omen.providers.llamacpp.rpcServers": {
          "type": "string",
          "default": "",
          "description": "RPC worker address, for example 192.168.68.54:50052"
        },
        "omen.providers.llamacpp.contextSize": {
          "type": "number",
          "default": 2048,
          "description": "Context size passed as -c"
        },
        "omen.providers.llamacpp.gpuLayers": {
          "type": "number",
          "default": 99,
          "description": "GPU layers passed as -ngl"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  }
}
